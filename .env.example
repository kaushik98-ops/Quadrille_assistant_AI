# ---- LLM -----------------------------------------------------------------
# Which backend to use: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Leave empty to use the provider default set in core/llm/factory.py
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Storage -------------------------------------------------------------
DB_PATH=data/app.db
SANDBOX_DIR=data/sandbox
PDF_DIR=data/pdfs
CHROMA_PATH=data/chroma
# Leave CHROMA_HOST empty to keep vectors on local disk. Docker Compose sets it for you.
CHROMA_HOST=
CHROMA_PORT=8000

# ---- RAG -----------------------------------------------------------------
# Embeddings: local (no key needed) | openai. Switching providers means re-ingesting your PDFs.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
RAG_TOP_K=4
RAG_MIN_SCORE=0.25

# ---- Router and agent ----------------------------------------------------
ROUTER_MIN_CONFIDENCE=0.6
ROUTER_HISTORY_MESSAGES=6
# Leave AGENT_MCP_URL empty to spawn the MCP server as a subprocess, or set it to
# e.g. http://127.0.0.1:8000/mcp to use a running server (then set AGENT_MCP_API_KEY).
AGENT_MCP_URL=
AGENT_MCP_API_KEY=
AGENT_MAX_STEPS=6
AGENT_MAX_OBSERVATION_CHARS=4000

# ---- API -----------------------------------------------------------------
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Several keys can be comma-separated. Each key gets its own conversations and rate limit.
API_KEYS=
API_HOST=127.0.0.1
API_PORT=8000
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=20

# ---- Logging -------------------------------------------------------------
LOG_LEVEL=INFO

# ---- Docker only ---------------------------------------------------------
# Chroma server image tag AND the chromadb version installed in the app image. They must match.
# Tested with 1.5.9 (see constraints.txt). Check with:  pip show chromadb
CHROMA_VERSION=1.5.9
APP_PORT=8000
# Where the app container finds Ollama (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434
# Used only by the optional HTTPS proxy (docker compose --profile tls up)
DOMAIN=localhost
